on early-init
    chown system graphics /sys/class/drm/card0/device/power/control

on fs
    # add Audio_DataWhale
    chmod 0666 /dev/xlog

on post-fs-data
    # camera
    mkdir /data/vendor/camera/offlinelog 0777 cameraserver audio
    mkdir /data/vendor/camera/aftersalelog 0777 cameraserver audio

    # video
    mkdir /data/vendor/video 0777 audio audio
    write /data/vendor/video/videohalPid 0
    chown audio audio /data/vendor/video/videohalPid
    chmod 0777 /data/vendor/video/videohalPid
    write /data/vendor/video/vppservicePid 0
    chown audio audio /data/vendor/video/vppservicePid
    chmod 0777 /data/vendor/video/vppservicePid

    # radio
    mkdir /data/vendor/radio/apkmbnconfig 0777 radio radio
    mkdir /data/vendor/radio/sha256 0777 radio radio
    mkdir /data/vendor/radio/efs 0777 radio radio

    # qrtr-lookup
    mkdir /data/vendor/qrtr 0775 system system

on early-boot
    # Modem
    mkdir /data/vendor/modem 0777 root root
    mkdir /data/vendor/modem/diag_logs 0777 root root

on boot
    # Disable FB scaling // xiaomi disables it in qti_display_boot scripts
    setprop vendor.display.enable_fb_scaling 1

    # Xiaomi touch
    chown system system /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chmod 0660 /sys/class/touch/touch_dev/gesture_single_tap_enabled
    chown system system /sys/devices/virtual/touch/touch_dev/bump_sample_rate
    chmod 0666 /sys/devices/virtual/touch/touch_dev/bump_sample_rate
    chown system system /sys/devices/virtual/touch/touch_dev/game_mode
    chmod 0666 /sys/devices/virtual/touch/touch_dev/game_mode
    chown system system /sys/devices/virtual/touch/touch_dev/touch_filters
    chmod 0666 /sys/devices/virtual/touch/touch_dev/touch_filters

on property:sys.boot_completed=1
    write /dev/kmsg "start qrtr-lookup after Boot completed "
    start qrtr-lookup

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

service qrtr-lookup /vendor/bin/qrtr-lookup
    class core
    user system
    group system
    disabled
    oneshot

service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    override
    class hal
    user audioserver
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct oem_2901 wakelock oem_2912 context_hub system
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    socket audio_holder_socket_0 seqpacket 0666 system system
    socket audio_us_socket_0 seqpacket 0666 system system
    onrestart restart audioserver

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.multihal
    override
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    socket audio_us_socket_1 seqpacket 0666 system system
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
